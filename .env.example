# Copy to .env (gitignored) and fill in only the providers you run. Nothing
# loads it automatically:
#   set -a; . ./.env; set +a
# The `hash` provider and the whole test suite need none of these.

# --provider openai   (pip install -e '.[openai]')
OPENAI_API_KEY=sk-your-key-here

# --provider voyage   (pip install -e '.[voyage]')
VOYAGE_API_KEY=pa-your-key-here

# --provider cohere   (pip install -e '.[cohere]')
COHERE_API_KEY=your-key-here
